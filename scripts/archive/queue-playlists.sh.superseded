#!/usr/bin/env bash
# 현재 1번 재생목록(pipeline.sh) 완료 후, 아래 3개 재생목록을 순서대로 자동 처리.
# 각 재생목록 → <제목>/ 폴더에 편마다 mp4(720p)+mp3+txt+srt 생성.
# 재실행/재개 안전(idempotent). 디스크 여유 부족 시 자동 보호.
set -uo pipefail

PROFILE="chrome:Profile 1"
ROOT="/Users/titanism/projects/주식공부/멤버십"
MODEL="$HOME/models/whisper-ggml/ggml-large-v3-turbo-q5_0.bin"
LANG="ko"
FLOOR_GB=8   # 이 이하로 디스크가 줄면 다운로드 중단(보호)

PLAYLISTS=(
  "https://www.youtube.com/playlist?list=PLF67QBTodqAUjLK936XdzUB01Ih6ijWwm"   # 투자 스킬업
  "https://www.youtube.com/playlist?list=PLF67QBTodqAX8C-tjj2EjUJwdGPYYFXTT"   # 여니의 주식 상담소
  "https://www.youtube.com/playlist?list=PLF67QBTodqAXFHTtbH1zlwGEH7OvGBkCn"   # 여니의 능력범위 향상 프로젝트
)

log(){ echo "[$(date '+%m-%d %H:%M:%S')] $*"; }
free_gb(){ df -g "$ROOT" | tail -1 | awk '{print $4}'; }

# ---------- 0) 1번 재생목록 파이프라인 완료 대기 ----------
log "=== 대기: 진행 중인 1번 재생목록(pipeline.sh) 완료 대기 ==="
while pgrep -f 'pipeline\.sh' >/dev/null 2>&1; do sleep 120; done
log "1번 재생목록 완료 확인. 큐 시작."

process_playlist(){
  local url="$1"
  local title dest
  title=$(yt-dlp --cookies-from-browser "$PROFILE" --flat-playlist --no-warnings \
            --playlist-items 1 --print "%(playlist_title)s" "$url" 2>/dev/null | head -1)
  [ -z "$title" ] && { log "!! 제목 조회 실패, 건너뜀: $url"; return; }
  local safe="${title//\//_}"
  dest="$ROOT/$safe"
  mkdir -p "$dest"
  log "########## 재생목록: $title ##########"

  # 디스크 보호
  local fg; fg=$(free_gb)
  if [ "${fg:-0}" -lt "$FLOOR_GB" ]; then
    log "!! 디스크 여유 ${fg}GB < ${FLOOR_GB}GB. 다운로드 생략, 기존 파일만 처리."
  else
    log "[다운로드] 720p mp4 (여유 ${fg}GB)"
    yt-dlp \
      --cookies-from-browser "$PROFILE" \
      -f "bv*[height<=720][vcodec^=avc1]+ba[acodec^=mp4a]/bv*[height<=720][ext=mp4]+ba[ext=m4a]/b[height<=720][ext=mp4]/bv*[height<=720]+ba/b[height<=720]" \
      --merge-output-format mp4 \
      --download-archive "$dest/.download-archive.txt" \
      --ignore-errors --no-warnings --newline \
      -o "$dest/%(playlist_index)02d - %(title)s.%(ext)s" \
      "$url"
  fi

  # mp3 + 스크립트
  shopt -s nullglob
  local f base name
  for f in "$dest"/*.mp4; do
    base="${f%.mp4}"; name="$(basename "$base")"
    if [ ! -f "$base.mp3" ]; then
      log "[mp3] $name"
      ffmpeg -y -loglevel error -i "$f" -vn -c:a libmp3lame -b:a 192k "$base.mp3" </dev/null \
        && log "[mp3] 완료" || log "[mp3] 실패: $name"
    fi
    if [ ! -f "$base.txt" ]; then
      log "[stt] $name (변환중...)"
      local wav="$base.16k.wav"
      ffmpeg -y -loglevel error -i "$f" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$wav" </dev/null
      if [ -f "$wav" ]; then
        whisper-cli -m "$MODEL" -f "$wav" -l "$LANG" -otxt -osrt -of "$base" -t 8 -pp </dev/null \
          && log "[stt] 완료: $name" || log "[stt] 실패: $name"
        rm -f "$wav"
      else
        log "[stt] wav 변환 실패: $name"
      fi
    fi
  done
  log "########## 완료: $title ##########"
}

for pl in "${PLAYLISTS[@]}"; do
  process_playlist "$pl"
done

log "=== 전체 큐 완료 ==="
echo "--- 최종 요약 ---"
for d in "$ROOT"/*/; do
  m=$(find "$d" -name '*.mp4' | wc -l | tr -d ' ')
  a=$(find "$d" -name '*.mp3' | wc -l | tr -d ' ')
  t=$(find "$d" -not -name '.download-archive.txt' -name '*.txt' | wc -l | tr -d ' ')
  echo "$(basename "$d"): mp4=$m mp3=$a txt=$t"
done
