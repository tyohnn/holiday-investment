# macOS
.DS_Store

# 파이프라인 운영 로그 (재현 가능, 용량만 큼)
*.log

# 구버전 백업 (git 히스토리가 버전관리를 대신함)
backup/

# 설치된 외부 스킬 (팀원 각자 설치, 저장소에 불필요)
.agents/
skills-lock.json

# Web app (apps/web)
apps/web/node_modules/
apps/web/.next/
apps/web/out/
apps/web/content/book/
apps/web/next-env.d.ts
apps/web/*.tsbuildinfo
node_modules/

# Python
__pycache__/

# API 키 (커밋 금지)
.env.local

# DART 사업보고서 원본 XML (대용량 — 스크립트로 언제든 재취득 가능)
리서치/**/원본/**/*.xml

# platform 로컬 산출물
platform/data/

# Supabase CLI 잔여물 (레포 루트에서 CLI 실행 시 재생성됨)
/supabase/

# 개인 저작 노트 (34 MB·613파일) — 저장소의 교재/·강의/ 와 성격은 같지만 로컬 전용이다
/내 주식강의/
